{
  "expo": {
    "name": "x2-news-stand",
    "slug": "x2-news-stand",
    "version": "0.1.0",
    "scheme": "x2newsstand",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon-1024.png",
    "ios": {
      "bundleIdentifier": "com.example.x2newsstand",
      "icon": "./assets/icon-1024.png",
      "deploymentTarget": "15.5"
    },
    "android": {
      "package": "com.example.x2newsstand",
      "icon": "./assets/icon-1024.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ]
  }
}
